# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_SSL=true

# Internal Security
API_KEY=admin-key-123
JWT_SECRET=supersecret_aps_key_2026

# A3 Chatbot LLM Provider
# Options: 'groq' (fastest & recommended), 'mock' (no key needed), 'gemini', 'openai'
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ─── Teleforce CRM (A1 Lead Sync) ────────────────────────────────────────────
CRM_PROVIDER=teleforce
TELEFORCE_CRM_API_URL=https://platformapi.teleforce.cx/api/v1/api/createlead/<ORG_ID>
TELEFORCE_CRM_CLIENT_SECRET=your_teleforce_client_secret
TELEFORCE_CRM_ORG_ID=your_org_id
TELEFORCE_CRM_LOGIN_EMAIL=your_email@domain.com
TELEFORCE_DOCS_URL=https://docs.teleforce.cx/

# ─── Teleforce Dialer (A4 Auto-Dialer / Voice AI) ─────────────────────────────
DIALER_PROVIDER=teleforce
TELEFORCE_DIALER_API_URL=https://platformapi.teleforce.cx/api/v1
TELEFORCE_DIALER_ACCOUNT_SID=your_account_sid
TELEFORCE_DIALER_CALLER_ID=+91XXXXXXXXXX

# ─── DoubleTick WhatsApp (A5 WhatsApp Automation) ────────────────────────────
WHATSAPP_PROVIDER=doubletick
DOUBLETICK_API_BASE_URL=https://web.doubletick.io/v1
DOUBLETICK_TEMPLATES_URL=https://web.doubletick.io/v1/templates
DOUBLETICK_WEBHOOK_URL=https://web.doubletick.io/v1/settings/webhooks
DOUBLETICK_SETTINGS_URL=https://web.doubletick.io/v1/settings/developer-api
DOUBLETICK_API_KEY=your_doubletick_api_key

# ─── Social Media ─────────────────────────────────────────────────────────────
FACEBOOK_LOGIN_EMAIL=your_fb_email
FACEBOOK_PASSWORD=your_fb_password
INSTAGRAM_USERNAME=your_ig_username
INSTAGRAM_PASSWORD=your_ig_password

# ─── Google Tasks Integration ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google-tasks/oauth/callback
GOOGLE_TASKS_FRONTEND_REDIRECT=http://localhost:5173/tasks
GOOGLE_TASKS_DEFAULT_LIST_NAME=APS Enterprise Follow-ups

