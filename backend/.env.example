# Server Configuration
PORT=5000
NODE_ENV=development

# A3 Chatbot LLM Provider
# Options: 'groq' (fastest & recommended), 'mock' (no key needed), 'gemini', 'openai'
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Internal A2 Security
API_KEY=admin-key-123
JWT_SECRET=supersecret_aps_key_2026

# A3 AI Chatbot — Internal NL Query Engine
# LLM_PROVIDER options: 'mock' (no key needed), 'openai', 'gemini'
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here

# External Integrations (Mock Mode Enabled if left empty)
CRM_ENDPOINT=https://api.crm.example.com/v1
CRM_API_KEY=crm_secret_key

ERP_ENDPOINT=https://api.erp.example.com/v1
ERP_API_KEY=erp_secret_key

DIALER_ENDPOINT=https://api.dialer.example.com/v1
DIALER_API_KEY=dialer_secret_key

TALLY_ENDPOINT=http://localhost:9000
TALLY_API_KEY=tally_secret_key

WHATSAPP_TOKEN=whatsapp_business_api_token
WHATSAPP_PHONE_ID=10092834019284

EXOTEL_SID=exotel_account_sid
EXOTEL_TOKEN=exotel_auth_token
ELEVENLABS_API_KEY=elevenlabs_voice_api_key
