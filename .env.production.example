# ============================================================
# APS ENTERPRISE — PRODUCTION ENVIRONMENT CONFIGURATION SPEC
# Copy to .env in production deployment environments
# ============================================================

# ─── 1. Core Server & Environment ────────────────────────────
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ─── 2. Database Connection (PostgreSQL / Supabase) ───────────
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres
DATABASE_SSL=true

# ─── 3. Security, Authentication & Session Tokens ─────────────
# Use cryptographically random strings (min 32 chars)
API_KEY=your_production_secure_admin_api_key_here
JWT_SECRET=your_production_jwt_signing_secret_here

# ─── 4. Groq LLM Intelligence Engine (A3 Assistant) ───────────
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_production_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─── 5. Teleforce CRM (A1 Lead Synchronization) ───────────────
CRM_PROVIDER=teleforce
TELEFORCE_CRM_API_URL=https://platformapi.teleforce.cx/api/v1/api/createlead/32263
TELEFORCE_CRM_CLIENT_SECRET=your_teleforce_client_secret_here
TELEFORCE_CRM_ORG_ID=32268
TELEFORCE_CRM_LOGIN_EMAIL=admin@apsenterprises.in

# ─── 6. Teleforce Smart Dialer & Agent Call Bridge (A4) ───────
DIALER_PROVIDER=teleforce
TELEFORCE_DIALER_API_URL=https://platformapi.teleforce.cx/api/v1
TELEFORCE_DIALER_ACCOUNT_SID=32268
TELEFORCE_DIALER_CALLER_ID=+919988001122

# ─── 7. WhatsApp Business Cloud / DoubleTick (A5) ─────────────
WHATSAPP_PROVIDER=doubletick
DOUBLETICK_API_BASE_URL=https://web.doubletick.io/v1
DOUBLETICK_API_KEY=your_doubletick_api_key_here
DOUBLETICK_WEBHOOK_SECRET=your_webhook_verification_secret_here
